#!/usr/bin/env bash
# PXY installer: fresh setup with a recoverable backup of any prior installation.
# Stops an existing PXY runtime before replacing its files.
set -Eeuo pipefail
ROOT="$HOME/PXY"
APP="$ROOT/pxy"
VENV="$HOME/env"
BIN="$HOME/.local/bin"
log() { printf '[PXY] %s\n' "$*"; }
fail() { printf '[PXY] ERROR: %s\n' "$*" >&2; exit 1; }
trap 'fail "Installation failed at line $LINENO"' ERR

[[ "$EUID" -ne 0 ]] || fail "Run as your normal PXY user, not root."
command -v sudo >/dev/null || fail "sudo is required."
command -v apt-get >/dev/null || fail "Requires Ubuntu/Debian apt."
REPO="git@github.com:PreciseXceleratedYield/PXY.git"
web_http=1
case "${1:-}" in
    "") ;;
    --web-http) web_http=1 ;;
    --no-web-http) web_http=0 ;;
    *) fail "Usage: bash pxyinst [--web-http|--no-web-http]" ;;
esac
(( $# <= 1 )) || fail "Usage: bash pxyinst [--web-http|--no-web-http]"
if (( web_http )) && [[ ! -d /run/systemd/system ]]; then
    fail "HTTP proxy setup requires systemd. Use --no-web-http to skip it."
fi

if [[ -e "$ROOT" && ! -d "$ROOT/.git" ]]; then
    fail "$ROOT exists but is not a Git checkout; refusing to overwrite it."
fi

if ! command -v git >/dev/null || ! command -v ssh >/dev/null || ! command -v ssh-keygen >/dev/null; then
    sudo apt-get update
    sudo apt-get install -y git openssh-client
fi

ssh_command="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new}"
clone_config=()
if [[ -d "$ROOT/.git" && -z "${GIT_SSH_COMMAND:-}" ]]; then
    saved_ssh_command=$(git -C "$ROOT" config --local --get core.sshCommand || true)
    if [[ -n "$saved_ssh_command" ]]; then
        ssh_command="$saved_ssh_command"
        clone_config=(--config "core.sshCommand=$ssh_command")
    fi
fi
log "Checking GitHub access to the PXY repository."
if ! probe="$(GIT_SSH_COMMAND="$ssh_command" git ls-remote --exit-code "$REPO" HEAD 2>&1)"; then
    if [[ "$probe" != *"Permission denied (publickey)"* && "$probe" != *"Repository not found"* ]]; then
        fail "GitHub access check failed: $probe"
    fi

    key="$HOME/.ssh/pxy_github"
    mkdir -p -m 700 "$HOME/.ssh"
    if [[ ! -e "$key" && ! -e "$key.pub" ]]; then
        ssh-keygen -q -t ed25519 -N '' -f "$key" -C "pxy@$(hostname)" </dev/null
    fi
    [[ -f "$key" && -f "$key.pub" ]] || fail "Incomplete deploy key at $key. Restore the matching key files before retrying."

    printf -v quoted_key '%q' "$key"
    ssh_command="ssh -i $quoted_key -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"
    if ! probe="$(GIT_SSH_COMMAND="$ssh_command" git ls-remote --exit-code "$REPO" HEAD 2>&1)"; then
        if [[ "$probe" != *"Permission denied (publickey)"* && "$probe" != *"Repository not found"* ]]; then
            fail "GitHub deploy-key check failed: $probe"
        fi
        log "Add this public key as a read-only deploy key:"
        log "https://github.com/PreciseXceleratedYield/PXY/settings/keys"
        cat "$key.pub"
        [[ -t 0 ]] || fail "Approve the deploy key, then rerun the installer in a terminal."
        while true; do
            if ! read -r -p "[PXY] Have you added the deploy key on GitHub? [yes/no] " answer; then
                fail "No response. Approve the deploy key and rerun the installer."
            fi
            case "${answer,,}" in
                y|yes)
                    if probe="$(GIT_SSH_COMMAND="$ssh_command" git ls-remote --exit-code "$REPO" HEAD 2>&1)"; then
                        log "GitHub access verified. Continuing installation."
                        break
                    fi
                    log "GitHub access is still unavailable: $probe"
                    log "Check that you added the public key to the PXY repository."
                    ;;
                n|no)
                    log "Installation stopped. Rerun it after approving the deploy key."
                    exit 1
                    ;;
                *) log "Please enter yes or no." ;;
            esac
        done
    fi
    clone_config=(--config "core.sshCommand=$ssh_command")
fi

touch "$HOME/.hushlogin"
sudo -v
sudo apt-get update
sudo apt-get install -y git python3 python3-venv python3-pip nodejs npm tmux openssh-client

# Prepare and validate the replacement before moving the existing installation.
staging=$(mktemp -d "$HOME/.pxy-install.XXXXXXXX")
trap 'rm -rf -- "$staging"' EXIT
log "Cloning a fresh PXY checkout."
GIT_SSH_COMMAND="$ssh_command" git clone "${clone_config[@]}" "$REPO" "$staging/PXY"
[[ -f "$staging/PXY/pxy/pxy.js" && -f "$staging/PXY/pxy/sys/sysexepxy.py" && -f "$staging/PXY/pxy/pxywatch" ]] ||
    fail "Missing current PXY application files in the fresh clone."

pxy_is_running() {
    systemctl is-active --quiet pxywatch.service 2>/dev/null ||
        pgrep -u "$EUID" -f '[s]ysexepxy[.]py|[n]ode .*pxy[.]js|[/]pxy/sys/exe/exe[a-z]*pxy[.]py' >/dev/null ||
        tmux has-session -t '=pxy-engine' 2>/dev/null ||
        tmux has-session -t '=pxy-web' 2>/dev/null
}

if pxy_is_running; then
    log "Stopping the watchdog, engine and WebPXY before reinstalling."
    bash "$staging/PXY/pxy/pxywatch" stop ||
        fail "PXY shutdown failed. The current installation was not moved."
    if pxy_is_running; then
        fail "A PXY service or process is still running. The current installation was not moved."
    fi
fi

if [[ -e "$ROOT" || -L "$ROOT" || -e "$VENV" || -L "$VENV" ]]; then
    backup=$(mktemp -d "$HOME/pxy-backup-$(date +%Y%m%d-%H%M%S).XXXXXXXX")
    log "Saving previous checkout and Python environment in $backup."
    if [[ -e "$ROOT" || -L "$ROOT" ]]; then mv -- "$ROOT" "$backup/PXY"; fi
    if [[ -e "$VENV" || -L "$VENV" ]]; then mv -- "$VENV" "$backup/env"; fi
fi
mv -- "$staging/PXY" "$ROOT"

python3 -m venv "$VENV"
"$VENV/bin/python3" -m pip install --upgrade pip
[[ -f "$APP/pxyinstl" ]] || fail "Missing $APP/pxyinstl"
"$VENV/bin/python3" -m pip install -r "$APP/pxyinstl"

if [[ -f "$APP/pxy.json" ]]; then
    cp "$APP/pxy.json" "$APP/package.json"
elif [[ ! -f "$APP/package.json" ]]; then
    fail "Missing Node.js package manifest."
fi
( cd "$APP" && npm install --no-audit --no-fund )

mkdir -p "$BIN"
for file in "$APP"/*; do
    [[ -f "$file" && "${file##*/}" != *.* ]] || continue
    install -m 755 "$file" "$BIN/${file##*/}"
done
log "Installed commands in $BIN"

[[ -f "$ROOT/.bashrc" ]] || fail "Missing Git-managed $ROOT/.bashrc"
if [[ -f "$HOME/.bashrc" ]] && ! cmp -s "$ROOT/.bashrc" "$HOME/.bashrc"; then
    backup="$HOME/.bashrc.pxy-backup-$(date +%Y%m%d-%H%M%S)"
    cp -p "$HOME/.bashrc" "$backup"
    log "Backed up previous .bashrc: $backup"
fi
install -m 644 "$ROOT/.bashrc" "$HOME/.bashrc"
log "Login will show the copyright notice from syscprtpxy.py (if dependencies are available)."

# Run the checkout updater directly so PATH cannot select an older copy.
(
    cd "$APP"
    log "Running pxyupdate (1 of 2)."
    bash ./pxyupdate
    log "Running pxyupdate (2 of 2)."
    bash ./pxyupdate
)

configure_web_http() {
    local config=/etc/nginx/conf.d/webpxy.conf previous
    log "Configuring HTTP on port 80 for WebPXY."
    sudo apt-get install -y nginx curl
    previous=$(mktemp)
    if sudo test -f "$config"; then
        sudo cat "$config" > "$previous"
    else
        rm -f -- "$previous"
    fi
    # Match IPv4 Host headers without publishing or hardcoding the VM address.
    sudo tee "$config" >/dev/null <<'NGINX'
map $http_upgrade $webpxy_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name ~^[0-9.]+$;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $webpxy_connection_upgrade;
    }
}
NGINX
    if ! sudo nginx -t || ! sudo systemctl enable --now nginx || ! sudo systemctl reload nginx; then
        if [[ -f "$previous" ]]; then
            sudo install -m 644 "$previous" "$config"
        else
            sudo rm -f -- "$config"
        fi
        rm -f -- "$previous"
        fail "Could not activate the WebPXY HTTP proxy. The previous Nginx configuration was restored."
    fi
    rm -f -- "$previous"

    sudo install -d -m 755 /etc/systemd/system/pxywatch.service.d
    sudo tee /etc/systemd/system/pxywatch.service.d/web-http.conf >/dev/null <<'SYSTEMD'
[Service]
Environment=PORT=8080
SYSTEMD
    log "HTTP proxy configured. In Azure, allow TCP 80 from your public IP and keep public access to 8080 closed."
}

if (( web_http )); then
    configure_web_http
fi

[[ -f "$APP/pxywatch" ]] || fail "Missing pxywatch."
if command -v systemctl >/dev/null && [[ -d /run/systemd/system ]]; then
    bash "$APP/pxywatch" install
    sudo systemctl enable pxywatch.service
    if systemctl is-active --quiet pxywatch.service; then
        log "Watchdog already running; not restarting it or the tmux sessions."
    else
        sudo systemctl start pxywatch.service
        log "Watchdog started."
    fi
else
    log "systemd unavailable; watchdog not installed."
fi

verify_web_http() {
    local attempt
    log "Waiting for WebPXY to answer through Nginx on port 80."
    for (( attempt=1; attempt<=15; attempt++ )); do
        if curl -fsS --max-time 3 -o /dev/null http://127.0.0.1/web/webpxy.html; then
            log "WebPXY is responding over HTTP on port 80."
            return 0
        fi
        if (( attempt < 15 )); then sleep 5; fi
    done
    fail "WebPXY did not respond through Nginx. Check pxywatch status and ~/.pxy/watchdog/pxy-web-current.out."
}

if (( web_http )); then
    verify_web_http
fi

log "Installation complete. Open a new Bash session to see the login banner."
