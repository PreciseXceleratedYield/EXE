#!/usr/bin/env bash
# PXYADM: one saved SSH destination, passwordless login via dedicated SSH key.
set -u
umask 077
# Install downloaded launcher into the user PATH on first -reset invocation.
if [ "${1:-}" = "-reset" ] && [ "${PXYADM_INSTALLED:-0}" != 1 ]; then
    target="$HOME/.local/bin/pxyadm"
    mkdir -p "$HOME/.local/bin" || exit 1
    current="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)/$(basename "$0")"
    if [ "$current" != "$target" ]; then
        cp "$current" "$target" || exit 1
        chmod 700 "$target" || exit 1
        if [ "$(uname -s)" = "Darwin" ]; then
            line='export PATH="$HOME/.local/bin:$PATH"'
            grep -Fqx "$line" "$HOME/.zshrc" 2>/dev/null || printf '\n%s\n' "$line" >> "$HOME/.zshrc"
        fi
        echo "PXYADM installed: $target"
        PXYADM_INSTALLED=1 exec bash "$target" -reset
    fi
fi

CONFIG_DIR="$HOME/.config/pxyadm"
CONFIG_FILE="$CONFIG_DIR/connection"
KEY_FILE="$CONFIG_DIR/id_ed25519"

detect_platform() {
    case "$(uname -s)" in
        Darwin) echo "macOS" ;;
        Linux)
            if [ -d /proc/ish ] || { [ -r /proc/version ] && grep -qi ish /proc/version; }; then
                echo "iSH"
            else
                echo "Linux"
            fi ;;
        *) echo "Unsupported"; return 1 ;;
    esac
}

reset_pxyadm() {
    local path answer
    local -a paths=()
    echo "PXYADM reset on $(detect_platform)" || return 1
    for path in "$HOME/.config/pxyadm" "$HOME/.cache/pxyadm" \
                "$HOME/.local/share/pxyadm" "$HOME/.local/state/pxyadm" \
                "$HOME/.pxyadm"; do
        if [ -L "$path" ]; then
            echo "Skipping symbolic link: $path"
        elif [ -e "$path" ]; then
            paths+=("$path")
        fi
    done
    if [ "${#paths[@]}" -eq 0 ]; then
        echo "No known PXYADM-owned storage found. Nothing deleted."
        return 0
    fi
    printf 'PXYADM paths to delete:\n'
    printf '  %s\n' "${paths[@]}"
    echo "WARNING: This deletes the dedicated local SSH key. Its authorized_keys entry on the remote server is NOT removed."
    read -r -p "Type RESET PXYADM to confirm: " answer || return 1
    [ "$answer" = "RESET PXYADM" ] || { echo "Reset cancelled."; return 1; }
    for path in "${paths[@]}"; do
        [ ! -L "$path" ] || continue
        rm -rf -- "$path" || return 1
        echo "Removed: $path"
    done
    echo "PXYADM local reset complete."
}

case "${1:-}" in
    -reset)
        [ "$#" -eq 1 ] || { echo "Usage: pxyadm [-reset]" >&2; exit 2; }
        reset_pxyadm; exit $? ;;
    "")
        [ "$#" -eq 0 ] || exit 2 ;;
    *) echo "Usage: pxyadm [-reset]" >&2; exit 2 ;;
esac

platform=$(detect_platform) || { echo "Unsupported platform." >&2; exit 1; }
command -v ssh >/dev/null && command -v ssh-keygen >/dev/null || {
    echo "OpenSSH client and ssh-keygen required on $platform." >&2; exit 1;
}

if [ -L "$CONFIG_DIR" ] || [ -L "$CONFIG_FILE" ] || [ -L "$KEY_FILE" ]; then
    echo "Refusing symlinked PXYADM configuration or key paths." >&2; exit 1
fi

if [ ! -f "$CONFIG_FILE" ]; then
    echo "First-time PXYADM setup ($platform). One server only."
    read -r -p "Server IP or hostname: " SERVER || exit 1
    read -r -p "SSH username [pxy]: " USERNAME || exit 1
    USERNAME="${USERNAME:-pxy}"
    # Avoid shell metacharacters, options, whitespace and SSH config injection.
    [[ "$SERVER" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] && [[ "$SERVER" != *:* ]] || {
        echo "Invalid hostname or IPv4 address." >&2; exit 1;
    }
    [[ "$USERNAME" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]] || {
        echo "Invalid SSH username." >&2; exit 1;
    }
    mkdir -p -- "$CONFIG_DIR" || exit 1
    chmod 700 "$CONFIG_DIR"
    if [ ! -f "$KEY_FILE" ]; then
        ssh-keygen -q -t ed25519 -N "" -f "$KEY_FILE" -C "pxyadm" || exit 1
    fi
    echo "Authorize the dedicated key on $USERNAME@$SERVER (SSH may ask for the server password once)."
    # No password is stored. ssh-copy-id handles safe authorized_keys installation.
    if command -v ssh-copy-id >/dev/null; then
        ssh-copy-id -i "$KEY_FILE.pub" -o StrictHostKeyChecking=accept-new -- "$USERNAME@$SERVER" || exit 1
    else
        echo "ssh-copy-id is missing. Install it, or manually append this public key to ~/.ssh/authorized_keys on the server:" >&2
        cat "$KEY_FILE.pub"
        echo "Then rerun pxyadm to finish setup." >&2
        exit 1
    fi
    if ! ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -i "$KEY_FILE" -- "$USERNAME@$SERVER" true; then
        echo "Key login verification failed; configuration not saved." >&2
        exit 1
    fi
    printf '%s\n%s\n' "$SERVER" "$USERNAME" > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
fi

[ -f "$KEY_FILE" ] && [ -f "$CONFIG_FILE" ] || {
    echo "Missing PXYADM key/configuration. Run pxyadm -reset and set up again." >&2; exit 1;
}
SERVER=$(sed -n '1p' "$CONFIG_FILE")
USERNAME=$(sed -n '2p' "$CONFIG_FILE")
[[ "$SERVER" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [[ "$USERNAME" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]] || {
    echo "Invalid PXYADM connection settings." >&2; exit 1;
}
echo "Connecting to $USERNAME@$SERVER..."
exec ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -i "$KEY_FILE" -- "$USERNAME@$SERVER"
