#!/bin/sh
# PXY self-updating cross-platform SSH launcher.
# PXYADM_RELEASE=3
# Increase PXYADM_RELEASE whenever a new launcher is published.
set -eu

case "${1:-}" in
  '') reset=0 ;;
  -reset|--reset) reset=1 ;;
  *) printf 'Usage: pxyadm [-reset]\n' >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { printf 'Usage: pxyadm [-reset]\n' >&2; exit 2; }

SELF=$0
case "$SELF" in
  /*) ;;
  *) SELF=$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd -P)
SELF="$SELF_DIR/$(basename -- "$SELF")"
USER_BIN="$HOME/.local/bin"
if [ "$reset" -eq 1 ]; then
  mkdir -p "$USER_BIN"
  USER_BIN=$(CDPATH= cd -- "$USER_BIN" && pwd -P)
fi
TARGET="$USER_BIN/pxyadm"

# Download-and-run bootstrap: install to a user-owned directory, never sudo.
if [ "$reset" -eq 1 ] && [ "$SELF" != "$TARGET" ]; then
  if [ ! -f "$TARGET" ] || ! cmp -s "$SELF" "$TARGET"; then
    install -m 755 "$SELF" "$TARGET"
    printf 'pxyadm: installed in %s (no sudo).\n' "$TARGET"
  fi
  # Make the user-owned launcher first in PATH for future zsh sessions.
  case "$(uname -s)" in
    Darwin)
      PROFILE="$HOME/.zshrc"
      PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'
      if [ ! -f "$PROFILE" ] || ! grep -Fqx "$PATH_LINE" "$PROFILE"; then
        printf '\n%s\n' "$PATH_LINE" >> "$PROFILE"
      fi
      ;;
  esac
  exec "$TARGET" "$@"
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pxyadm"
HOST_FILE="$CONFIG_DIR/host"
USER_FILE="$CONFIG_DIR/user"
CREDENTIALS_FILE="$CONFIG_DIR/credentials"

remove_saved_password() (
  saved_host=$1
  saved_user=$2
  [ -n "$saved_host" ] && [ -n "$saved_user" ] || return 0
  case "$(uname -s)" in
    Darwin)
      security delete-generic-password -s "PXY-SSH-$saved_host" -a "$saved_user" >/dev/null 2>&1 ||
        [ "$?" -eq 44 ]  # Keychain item already absent.
      ;;
    Linux)
      if ! command -v secret-tool >/dev/null 2>&1; then
        [ ! -s "$CREDENTIALS_FILE" ]
        return
      fi
      if secret-tool lookup application pxyadm host "$saved_host" user "$saved_user" >/dev/null; then
        secret-tool clear application pxyadm host "$saved_host" user "$saved_user"
      fi
      ;;
  esac
)

reset_local_settings() {
  reset_failed=0
  if [ -r "$CREDENTIALS_FILE" ]; then
    while IFS=' ' read -r saved_host saved_user; do
      remove_saved_password "$saved_host" "$saved_user" || reset_failed=1
    done < "$CREDENTIALS_FILE"
  fi
  if [ -r "$HOST_FILE" ]; then
    IFS= read -r saved_host < "$HOST_FILE" || :
    remove_saved_password "$saved_host" "${PXY_SSH_USER:-pxy}" || reset_failed=1
  fi
  remove_saved_password "${PXY_SSH_HOST:-}" "${PXY_SSH_USER:-pxy}" || reset_failed=1
  if [ "$reset_failed" -ne 0 ]; then
    printf 'pxyadm: could not clear every saved password. Unlock the credential vault and retry.\n' >&2
    exit 1
  fi
  rm -rf -- "$CONFIG_DIR"
}

# Archive old launcher copies only where this user can write.
archive_path_launchers() (
  umask 077
  backup_dir=
  remaining_path="${PATH:-}:$HOME/bin:/usr/local/bin:/usr/bin"
  while [ -n "$remaining_path" ]; do
    case "$remaining_path" in
      *:*) directory=${remaining_path%%:*}; remaining_path=${remaining_path#*:} ;;
      *) directory=$remaining_path; remaining_path= ;;
    esac
    directory=$(CDPATH= cd -- "${directory:-.}" 2>/dev/null && pwd -P) || continue
    candidate="$directory/pxyadm"
    [ -f "$candidate" ] && [ -w "$directory" ] || continue
    [ "$candidate" != "$SELF" ] && [ ! "$candidate" -ef "$SELF" ] || continue
    [ "$candidate" != "$HOME/PXY/pxy/pxyadm" ] && [ ! "$candidate" -ef "$HOME/PXY/pxy/pxyadm" ] || continue
    if ! grep -q '^# PXY self-updating cross-platform SSH launcher\.' "$candidate" 2>/dev/null; then
      grep -Eq 'PreciseXceleratedYield/(PXY|EXE)|^[[:space:]]*BHANU_IP=' "$candidate" 2>/dev/null &&
        grep -Eq 'sshpass|(^|[[:space:]])ssh[[:space:]]' "$candidate" 2>/dev/null || continue
    fi
    if [ -z "$backup_dir" ]; then
      backup_root="${XDG_CONFIG_HOME:-$HOME/.config}/pxyadm/backups"
      mkdir -p "$backup_root" || return
      backup_dir=$(mktemp -d "$backup_root/run.XXXXXXXX") || return
    fi
    destination=$(mktemp "$backup_dir/pxyadm.XXXXXXXX") || continue
    if mv -f "$candidate" "$destination"; then
      printf 'pxyadm: backed up %s to %s\n' "$candidate" "$destination"
    else
      rm -f "$destination"
    fi
  done
)



download_launcher() {
  url="https://raw.githubusercontent.com/PreciseXceleratedYield/EXE/main/pxyadm"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 5 --max-time 15 "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T 15 -O - "$url"
  else
    return 1
  fi
}

# Check for launcher updates only while reconfiguring.
if [ "$reset" -eq 1 ] && [ "${PXYADM_UPDATED:-0}" != 1 ]; then
  printf 'pxyadm: checking for updates (up to 15 seconds).\n' >&2
  TMP=$(mktemp "${TMPDIR:-/tmp}/pxyadm.XXXXXXXX") || TMP=
  if [ -n "$TMP" ]; then
    current_release=$(sed -n 's/^# PXYADM_RELEASE=\([1-9][0-9]*\)$/\1/p' "$SELF")
    if download_launcher >"$TMP" 2>/dev/null \
      && [ -s "$TMP" ] \
      && [ "$(head -n 1 "$TMP")" = '#!/bin/sh' ] \
      && grep -q '^# PXY self-updating cross-platform SSH launcher\.' "$TMP" \
      && next_release=$(sed -n 's/^# PXYADM_RELEASE=\([1-9][0-9]*\)$/\1/p' "$TMP") \
      && [ "$next_release" -gt "$current_release" ] 2>/dev/null \
      && sh -n "$TMP"; then
      chmod 755 "$TMP"
      if mv -f "$TMP" "$SELF"; then
        printf 'pxyadm: updated from GitHub main.\n'
        PXYADM_UPDATED=1
        export PXYADM_UPDATED
        exec "$SELF" "$@"
      fi
    fi
    [ ! -f "$TMP" ] || rm -f "$TMP"
  fi
fi

if ! command -v ssh >/dev/null 2>&1; then
  printf 'pxyadm: SSH client not found.\n' >&2
  exit 1
fi

REMOTE_USER=${PXY_SSH_USER:-pxy}
if [ "$reset" -eq 0 ] && [ -r "$USER_FILE" ]; then
  IFS= read -r REMOTE_USER < "$USER_FILE" || :
fi

if [ "$reset" -eq 1 ]; then
  archive_path_launchers || printf 'pxyadm: could not move all old launchers.\n' >&2
  reset_local_settings
  printf 'PXY server IP or SSH host alias: ' >&2
  IFS= read -r REMOTE_HOST || exit 1
elif [ -r "$HOST_FILE" ]; then
  IFS= read -r REMOTE_HOST < "$HOST_FILE" || :
else
  printf 'pxyadm: no saved host. Run pxyadm -reset to set up.\n' >&2
  exit 1
fi

case "$REMOTE_HOST" in
  ''|-*|*[!a-zA-Z0-9._:%-]*)
    printf 'pxyadm: enter a valid server IP or SSH host alias.\n' >&2
    exit 1
    ;;
esac

SERVICE="PXY-SSH-$REMOTE_HOST"
STORE=none
if command -v sshpass >/dev/null 2>&1; then
  case "$(uname -s)" in
    Darwin) if command -v security >/dev/null 2>&1; then STORE=keychain; fi ;;
    Linux) if command -v secret-tool >/dev/null 2>&1; then STORE=secret-service; fi ;;
  esac
fi

get_saved_password() {
  case "$STORE" in
    keychain) security find-generic-password -s "$SERVICE" -a "$REMOTE_USER" -w 2>/dev/null ;;
    secret-service) secret-tool lookup application pxyadm host "$REMOTE_HOST" user "$REMOTE_USER" 2>/dev/null ;;
  esac
}

ssh_with_password() {
  SSHPASS="$PASSWORD" sshpass -e ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    -o PubkeyAuthentication=no -o PreferredAuthentications=password -o NumberOfPasswordPrompts=1 \
    "$REMOTE_USER@$REMOTE_HOST" "$@"
}

if [ "$reset" -eq 0 ]; then
  printf 'pxyadm: connecting to %s@%s.\n' "$REMOTE_USER" "$REMOTE_HOST" >&2
  if [ "$STORE" = none ]; then
    exec ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST"
  fi
  PASSWORD=$(get_saved_password) || PASSWORD=
  if [ -z "$PASSWORD" ]; then
    printf 'pxyadm: no saved password. Run pxyadm -reset to set up.\n' >&2
    exit 1
  fi
  ssh_with_password
  exit 0
fi

if [ "$STORE" = none ]; then
  printf 'pxyadm: SSH will verify your login. A supported credential vault and sshpass are required to save a password.\n' >&2
  ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$REMOTE_USER@$REMOTE_HOST" true ||
    { printf 'pxyadm: login verification failed. Run pxyadm -reset to retry.\n' >&2; exit 1; }
else
  printf 'PXY Linux password: ' >&2
  STTY_STATE=$(stty -g 2>/dev/null || :)
  stty -echo 2>/dev/null || :
  IFS= read -r PASSWORD || PASSWORD=
  if [ -n "$STTY_STATE" ]; then stty "$STTY_STATE" 2>/dev/null || :; fi
  printf '\n' >&2
  if [ -z "$PASSWORD" ] || ! ssh_with_password true; then
    printf 'pxyadm: password verification failed. Run pxyadm -reset to retry.\n' >&2
    exit 1
  fi
  (
    umask 077
    mkdir -p "$CONFIG_DIR"
    printf '%s %s\n' "$REMOTE_HOST" "$REMOTE_USER" > "$CREDENTIALS_FILE"
  )
  case "$STORE" in
    keychain) security add-generic-password -U -s "$SERVICE" -a "$REMOTE_USER" -w "$PASSWORD" >/dev/null ;;
    secret-service) printf '%s' "$PASSWORD" | secret-tool store --label="PXY SSH $REMOTE_HOST" application pxyadm host "$REMOTE_HOST" user "$REMOTE_USER" ;;
  esac
fi

(
  umask 077
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$REMOTE_HOST" > "$HOST_FILE"
  printf '%s\n' "$REMOTE_USER" > "$USER_FILE"
)
printf 'pxyadm: setup complete. Run pxyadm to connect.\n'
